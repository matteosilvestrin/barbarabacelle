# Copia questo file in .env (in locale) e in produzione imposta le stesse variabili
# nell'ambiente dell'hosting. Il file .env non va committato.

# Google Analytics 4: ID di misurazione (G-XXXXXXXXXX). Letto al BUILD (vite.config.ts):
# dopo averlo cambiato va rifatto il build. Vuoto = nessun analytics e nessun banner.
GA4_ID=

# Server SMTP per l'invio delle email (server/contact.ts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Mittente e destinatari
MAIL_FROM_NAME=Espacio de estilo by Barbara
MAIL_FROM=hola@barbarabacelle.es
MAIL_TO=hola@barbarabacelle.es
MAIL_BCC=hola@barbarabacelle.es,barbara.bacelle@gmail.com

# Oggetti delle email
MAIL_SUBJECT_MASTERCLASS=Inscripción a la Masterclass
MAIL_SUBJECT_CONTACTO=Gracias por contactar con Espacio de estilo
# Facoltativo: oggetto della conferma per i contatti dal sito in italiano (se vuoto, si usa quello spagnolo)
MAIL_SUBJECT_CONTACTO_IT=Grazie per aver contattato Espacio de estilo

# Contenuti fissi usati nei template (server/email/templates.ts)
MAIL_LOGO_URL=https://www.barbarabacelle.es/logo-espacio-de-estilo-mail.png
MAIL_FOOTER=Espacio de estilo by Barbara Bacelle | Tel: +34 640 90 70 62 | Mail: hola@barbarabacelle.es | Web: www.barbarabacelle.es
